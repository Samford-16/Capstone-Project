# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection for the app
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/current_dev

# Separate database for `npm test`. The tests WIPE it.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/current_test

# Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

PORT=3000
JWT_EXPIRES_IN=8h
TZ_SCHOOL=America/New_York
INVOICE_DUE_DAYS=7

# Stripe (optional, TEST MODE ONLY). Leave blank to use the built-in demo checkout.
# Secret key: Stripe Dashboard > Developers > API keys (must start with sk_test_).
STRIPE_SECRET_KEY=
# Only needed for the webhook. Printed by: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends families back after paying. Use http://localhost:3000 if you
# run the built app from the backend instead of the Vite dev server.
APP_URL=http://localhost:5173
