// Current: database schema (PostgreSQL via Prisma).
// Money is stored as integer cents. Calendar dates use @db.Date (no time zone).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COACH
  PARENT
  SWIMMER
}

enum LessonStatus {
  ACTIVE
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  CANCELLED
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
  REFUNDED
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
}

/// Anyone who can sign in. Accounts are deactivated, never deleted,
/// so invoices and payments always point at a real person.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  swimmerProfile   Swimmer?        @relation("SwimmerAccount")
  children         ParentSwimmer[]
  coachedLessons   Lesson[]        @relation("LessonCoach")
  templateSlots    TemplateSlot[]  @relation("SlotCoach")
  enrollmentsMade  Enrollment[]    @relation("EnrolledBy")
  invoices         Invoice[]       @relation("BilledTo")
  paymentsRecorded Payment[]       @relation("RecordedBy")
  pricesSet        StagePrice[]    @relation("PriceSetBy")
}

/// The person taking lessons. A swimmer either has their own login
/// (userId set, role SWIMMER) or is managed by one or more parents.
model Swimmer {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  dateOfBirth DateTime? @db.Date
  stageId     Int?
  userId      Int?      @unique
  createdAt   DateTime  @default(now())

  stage       Stage?          @relation(fields: [stageId], references: [id])
  user        User?           @relation("SwimmerAccount", fields: [userId], references: [id])
  parents     ParentSwimmer[]
  enrollments Enrollment[]
}

model ParentSwimmer {
  parentId  Int
  swimmerId Int
  createdAt DateTime @default(now())

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  swimmer Swimmer @relation(fields: [swimmerId], references: [id], onDelete: Cascade)

  @@id([parentId, swimmerId])
}

/// Ability levels, Stage 1 through Stage 5.
model Stage {
  id          Int    @id
  name        String
  description String
  color       String

  prices        StagePrice[]
  lessons       Lesson[]
  swimmers      Swimmer[]
  templateSlots TemplateSlot[]
  invoices      Invoice[]
}

/// Price per session for a stage, with history. The rate used for an
/// invoice is the newest row whose effectiveFrom is on or before the
/// enrollment date.
model StagePrice {
  id            Int      @id @default(autoincrement())
  stageId       Int
  priceCents    Int
  effectiveFrom DateTime @db.Date
  createdById   Int?
  createdAt     DateTime @default(now())

  stage     Stage @relation(fields: [stageId], references: [id])
  createdBy User? @relation("PriceSetBy", fields: [createdById], references: [id])

  @@unique([stageId, effectiveFrom])
}

/// A reusable weekly pattern of lesson slots. Applying a template to a
/// date range creates one Lesson per slot.
model ScheduleTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots   TemplateSlot[]
  lessons Lesson[]
}

model TemplateSlot {
  id         Int     @id @default(autoincrement())
  templateId Int
  name       String?
  dayOfWeek  Int // 0 = Sunday ... 6 = Saturday
  startTime  String // "HH:MM", 24-hour
  endTime    String
  stageId    Int
  coachId    Int?
  capacity   Int
  location   String?

  template ScheduleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  stage    Stage            @relation(fields: [stageId], references: [id])
  coach    User?            @relation("SlotCoach", fields: [coachId], references: [id])
}

/// A class that meets weekly on one day and time between startDate and
/// endDate. Swimmers enroll in a Lesson; each meeting is a LessonSession.
model Lesson {
  id         Int          @id @default(autoincrement())
  name       String
  stageId    Int
  coachId    Int?
  dayOfWeek  Int
  startTime  String
  endTime    String
  capacity   Int
  location   String?
  startDate  DateTime     @db.Date
  endDate    DateTime     @db.Date
  status     LessonStatus @default(ACTIVE)
  templateId Int?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  stage       Stage             @relation(fields: [stageId], references: [id])
  coach       User?             @relation("LessonCoach", fields: [coachId], references: [id])
  template    ScheduleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sessions    LessonSession[]
  enrollments Enrollment[]

  @@index([dayOfWeek, startTime])
  @@index([coachId])
}

model LessonSession {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  date      DateTime @db.Date
  cancelled Boolean  @default(false)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, date])
  @@index([date])
}

model Enrollment {
  id           Int              @id @default(autoincrement())
  lessonId     Int
  swimmerId    Int
  enrolledById Int
  status       EnrollmentStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  cancelledAt  DateTime?

  lesson     Lesson   @relation(fields: [lessonId], references: [id])
  swimmer    Swimmer  @relation(fields: [swimmerId], references: [id])
  enrolledBy User     @relation("EnrolledBy", fields: [enrolledById], references: [id])
  invoice    Invoice?

  @@index([lessonId, status])
  @@index([swimmerId])
}

/// One invoice per enrollment: sessionCount x ratePerSessionCents.
/// Invoices are never deleted. Unpaid ones are voided; paid ones are refunded.
model Invoice {
  id                  Int           @id @default(autoincrement())
  enrollmentId        Int           @unique
  billedToId          Int
  stageId             Int
  sessionCount        Int
  ratePerSessionCents Int
  amountCents         Int
  status              InvoiceStatus @default(UNPAID)
  issuedAt            DateTime      @default(now())
  dueDate             DateTime      @db.Date
  voidedAt            DateTime?
  note                String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  billedTo   User       @relation("BilledTo", fields: [billedToId], references: [id])
  stage      Stage      @relation(fields: [stageId], references: [id])
  payments   Payment[]

  @@index([billedToId])
  @@index([status])
  @@index([issuedAt])
}

/// Money in (PAYMENT) or out (REFUND). amountCents is always positive.
model Payment {
  id           Int           @id @default(autoincrement())
  invoiceId    Int
  kind         PaymentKind   @default(PAYMENT)
  method       PaymentMethod
  amountCents  Int
  reference    String?
  receivedAt   DateTime      @default(now())
  recordedById Int?

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User?   @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([receivedAt])
}
